_*.ps1

# Secretos (PRD §5.2: nunca trackear credenciales)
.env
.env.*
!.env.example

# Configuración local de Claude Code (permisos de la máquina, no del proyecto).
# Los agentes sí son del proyecto y se versionan: git no desciende en un
# directorio excluido, así que hay que excluir el contenido y reabrir la
# subcarpeta, no basta con `.claude/` + `!.claude/agents/`.
.claude/*
!.claude/agents/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
