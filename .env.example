# Copia este archivo a ".env" y completa con las credenciales de tu proyecto Supabase.
# Mientras estas variables no estén configuradas, la app corre en modo demo
# con datos mock (ver src/lib/supabase.ts e isMockMode).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La clave de Anthropic NO va aquí. Todo lo que empieza por VITE_ acaba dentro
# del bundle que se descarga el navegador, así que una clave puesta en este
# archivo queda a la vista de cualquiera que abra la aplicación.
#
# El asistente llama al modelo desde una Edge Function
# (supabase/functions/asistente), y allí la clave es un secreto del proyecto:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase functions deploy asistente
#
# En local, con «supabase functions serve», va en supabase/functions/.env.local
# (que .gitignore ya excluye por el patrón *.local).
